{
  "about": "File NAMES (not paths) that the MCP server's checkout snapshot must classify: withheld = looks like a credential and is never uploaded; sent = ordinary. Rules: ContextStreamClient::is_secret_file_name (crates/mcp-client/src/client.rs).",
  "withheld": [
    ".env", ".env.local", ".env.production", ".env.ci", ".env.dev.local", ".ENV", ".Env.Staging",
    "id_rsa", "ID_RSA", "id_ed25519", "id_ecdsa", "known_hosts",
    "server.pem", "tls.KEY", "creds.p12", "cert.pfx", "store.jks",
    "credentials.json", "Credentials.JSON", "serviceAccountKey.json",
    ".npmrc", ".pypirc", ".netrc", ".pgpass", ".git-credentials",
    "kubeconfig", ".kubeconfig", ".dockercfg", ".htpasswd",
    "secrets.yaml", "secrets.yml", "secret.yaml", "secret.yml", "secrets.json", "secrets.toml",
    ".mcp.json", "mcp.json", "opencode.json",
    "prod.tfvars", "prod.tfvars.json", "terraform.tfstate", "terraform.tfstate.backup",
    "service-account.json", "serviceaccount.json", "my_serviceaccount_key.json", "gcp_service_account_prod.json", "Service-Account.JSON"
  ],
  "sent": [
    ".env.example", ".env.sample", ".env.template", ".env.dist", ".env.defaults", ".ENV.EXAMPLE", ".envrc",
    "environment.ts", "env.rs", "main.rs", "main.tf", "variables.tf", "terraform.tfvars.example",
    "Cargo.lock", "yarn.lock", "bun.lockb", "bundle.zip", "package.json", "tsconfig.json", "config.yaml", "notes.json",
    "id_rsa.pub", "known_hosts.go", "api.key.md", "my-mcp.json", "mcp.json.bak", "secrets.yaml.example", "secrets.rs", "secret_santa.py",
    "credentials.json.example", "service.json", "serviceaccount.go", "service-accounts.md", "service-account.md"
  ]
}
