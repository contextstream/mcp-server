{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "agent-coach-kit": {
      "type": "streamable-http",
      "url": "https://mcp.contextstream.io/coach",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["read:coach", "write:coach"]
          }
        }
      }
    }
  }
}
