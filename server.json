{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.contextstreamio/mcp-server",
  "title": "ContextStream MCP Server",
  "description": "ContextStream MCP server for code context, memory, search, and AI tools.",
  "version": "0.4.82",
  "repository": {
    "url": "https://github.com/contextstream/mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://contextstream.io/docs/mcp",
  "tags": [
    "code-context",
    "memory",
    "search",
    "knowledge-graph",
    "ai-tools"
  ],
  "icons": [
    {
      "src": "https://contextstream.io/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://contextstream.io/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@contextstream/mcp-server",
      "version": "0.4.82",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CONTEXTSTREAM_API_KEY",
          "description": "ContextStream API key (create one at contextstream.io)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "CONTEXTSTREAM_API_URL",
          "description": "API base URL",
          "isRequired": false,
          "default": "https://api.contextstream.io"
        }
      ]
    }
  ]
}
