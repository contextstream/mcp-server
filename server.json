{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.contextstream/mcp-server",
  "title": "ContextStream MCP Server",
  "description": "Project memory, semantic code search, and grounded agent context.",
  "version": "1.0.2",
  "repository": {
    "url": "https://github.com/contextstream/mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://contextstream.io/docs/mcp",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.contextstream.io/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@contextstream/mcp-server",
      "version": "1.0.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CONTEXTSTREAM_API_KEY",
          "description": "ContextStream API key",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "CONTEXTSTREAM_API_URL",
          "description": "ContextStream API base URL",
          "isRequired": false,
          "default": "https://api.contextstream.io"
        }
      ]
    }
  ]
}
