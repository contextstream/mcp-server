{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.contextstreamio/mcp-server",
  "title": "ContextStream MCP Server",
  "description": "ContextStream MCP server for code context, memory, search, and AI tools.",
  "version": "0.4.81",
  "repository": {
    "url": "https://github.com/contextstream/mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://contextstream.io/docs/mcp",
  "tags": [
    "code-context",
    "memory",
    "search",
    "knowledge-graph",
    "ai-tools"
  ],
  "icons": [
    {
      "src": "https://contextstream.io/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://contextstream.io/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.contextstream.io/mcp?default_context_mode=fast",
      "headers": [
        { "name": "X-ContextStream-Toolset", "value": "complete" },
        { "name": "X-ContextStream-Output-Format", "value": "compact" },
        { "name": "X-ContextStream-Search-Limit", "value": "15" },
        { "name": "X-ContextStream-Search-Max-Chars", "value": "2400" },
        { "name": "X-ContextStream-Transcripts-Enabled", "value": "true" },
        { "name": "X-ContextStream-Consolidated", "value": "true" }
      ]
    }
  ]
}
